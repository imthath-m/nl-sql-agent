# AI Studio path (simplest): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model for the live generator (Gemini Flash family).
NLSQL_MODEL=gemini-2.5-flash

# Override where the BIRD dev set lives (defaults to ../bird-data/dev_20240627).
# BIRD_DIR=/abs/path/to/dev_20240627

# Vertex path instead of AI Studio (full Google stack):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=us-central1
